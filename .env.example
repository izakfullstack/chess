# App settings
PORT=3002
APP_URL=http://localhost:3002
PLATFORM_NAME=פלטפורמת משחקי שחמט מקוונת

# PostgreSQL connection (required)
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/chess_tournament
PGPOOL_MAX=20

# Gmail SMTP settings for real email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@example.com
ADMIN_USERNAME=chess_manager
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional local-only demo users. Do not enable for production.
SEED_DEMO_USERS=false
